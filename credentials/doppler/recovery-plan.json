{
  "id": "secret-recovery",
  "paths": ["/secret-recovery"],
  "schedule": {"cron": "*/15 * * * *", "clock": "CLOCK_LOCAL"},
  "retention": {"policyTimeBucketed": {"daily": 14, "weekly": 8, "monthly": 12}},
  "hooks": [
    {
      "conditions": ["CONDITION_SNAPSHOT_START"],
      "onError": "ON_ERROR_FATAL",
      "actionCommand": {"command": "sh /hooks/validate-secret-recovery.sh /secret-recovery"}
    },
    {
      "conditions": ["CONDITION_SNAPSHOT_SUCCESS"],
      "actionCommand": {"command": "sh /hooks/record-backup-metric.sh secret-recovery"}
    },
    {
      "conditions": ["CONDITION_ANY_ERROR"],
      "actionCommand": {"command": "sh /hooks/notify-ntfy.sh secret-recovery 'Encrypted credential backup failed'"}
    }
  ]
}