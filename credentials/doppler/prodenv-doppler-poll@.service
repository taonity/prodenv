[Unit]
Description=Refresh Doppler credentials and recovery export for %i
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/prodenv-doppler/pilot.py poll /etc/prodenv-doppler/%i.json
TimeoutStartSec=30min
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=full