[Unit]
Description=Credential expiry metadata for %i

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/prodenv-doppler/pilot.py metrics /etc/prodenv-doppler/%i.json
UMask=0077
LimitCORE=0
PrivateTmp=true
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=full
InaccessiblePaths=-/etc/prodenv-doppler/tokens -/run/prodenv-secrets