[Unit]
Description=Local Doppler deployment broker
After=network-online.target docker.service
Requires=docker.service

[Service]
ExecStart=/usr/bin/python3 /opt/prodenv-doppler/broker.py
RuntimeDirectory=prodenv-doppler
RuntimeDirectoryMode=0700
Restart=on-failure
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target