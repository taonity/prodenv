[Unit]
Description=Doppler credential delivery for %i
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/prodenv-doppler/pilot.py deploy /etc/prodenv-doppler/%i.json
RemainAfterExit=yes
Restart=on-failure
RestartSec=5min
TimeoutStartSec=30min
UMask=0077
LimitCORE=0
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target