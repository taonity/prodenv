# Merge these selectors into the server's existing .env; retain its credentials.
COMPOSE_PROJECT_NAME=artist-insight-service-prod
SPRING_PROFILES_ACTIVE=prod
FRONTEND_PROFILE=prod
# Optional comma-separated Spotify account emails for console owner bootstrap.
CONSOLE_OWNER_EMAILS=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
OPENAI_API_KEY=
KOFI_VERIFICATION_TOKEN=
ADMIN_EMAIL=
ORGANISATION_EMAIL=
ORGANISATION_EMAIL_PASSWORD=
