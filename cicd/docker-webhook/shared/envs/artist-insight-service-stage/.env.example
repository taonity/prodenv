# Merge these selectors into the server's existing .env; retain its credentials.
COMPOSE_PROJECT_NAME=artist-insight-service-stage
SPRING_PROFILES_ACTIVE=stage
FRONTEND_PROFILE=stage
# Optional comma-separated Spotify IDs for console owner bootstrap.
CONSOLE_OWNER_SPOTIFY_IDS=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_APP_USER=
POSTGRES_APP_PASSWORD=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
OPENAI_API_KEY=
KOFI_VERIFICATION_TOKEN=
ADMIN_EMAIL=
ORGANISATION_EMAIL=
ORGANISATION_EMAIL_PASSWORD=
